# Set both to the same browser-facing HTTPS origin, without a trailing slash.
BETTER_AUTH_URL=https://meals.example.com
ORIGIN=https://meals.example.com

# Replace with a persistent random secret of at least 32 characters.
# Generate one with: openssl rand -hex 48
BETTER_AUTH_SECRET=CHANGE_ME

MAIL_DELIVERY=smtp
MAIL_FROM=login@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# For implicit TLS on port 465, use SMTP_PORT=465 and SMTP_SECURE=true.

# Configure only when the proxy overwrites this header with the real client IP,
# and the app port can be reached only by trusted proxies.
# ADDRESS_HEADER=x-real-ip
# For X-Forwarded-For instead, see the guide's client-address instructions.

# The unit defaults to localhost:3000 for a proxy on this host.
# For a remote proxy, set HOST to this machine's private address and firewall
# the port so only trusted proxies can reach it.
# HOST=192.0.2.10
# PORT=3000

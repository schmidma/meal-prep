# DEVELOPMENT — copy this file to .env, then run npm run dev.
# No email account is needed: sign-in codes print in the server terminal.
MAIL_DELIVERY=console
# The address you open in your browser. For Ethernet, use your computer's IP.
BETTER_AUTH_URL=http://127.0.0.1:5174

# REAL EMAIL — change MAIL_DELIVERY above to smtp, then fill in these values.
# Your email provider supplies the host, username and password.
# MAIL_FROM=Meal Prep <login@your-domain.com>
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_SECURE=false
# Port 587 uses STARTTLS. For port 465, set SMTP_SECURE=true.

# PRODUCTION ONLY — real email is required; console codes are never allowed.
# Set BETTER_AUTH_URL above and ORIGIN below to the same public HTTPS address.
# ORIGIN=https://meals.example.com
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Optional persistent storage location:
# MEAL_PREP_DB_PATH=/persistent/private-data/meal-prep.sqlite
